{
    "name": "hgabka/utils-bundle",
    "type": "symfony-bundle",
    "description": "Utils bundle",
    "keywords": [],
    "homepage": "https://github.com/hgabka/utils-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Gabe",
            "email": "hgabka@gmail.com",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/logger-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/node-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/media-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/settings-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/seo-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/doctrine-translatable.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/doctrine-translatable-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/email-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/simple-content-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/i18n-routing-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/acl-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/security-acl.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/pagepart-bundle.git"
        }
    ],
    "require": {
        "php": "^8.2",
        "doctrine/orm": "^3.7",
        "behat/transliterator": "^1.5",
        "symfony/acl-bundle": "^2.0",
        "symfony/framework-bundle": "^7.0|^8.0",
        "liip/imagine-bundle": "^2.1",
        "hgabka/doctrine-translatable-bundle": "^7.1|^8.0",
        "google/apiclient": "^2.7",
        "guzzlehttp/guzzle": ">= 6.3",
        "symfony/webpack-encore-bundle": "^2.0",
        "pagerfanta/pagerfanta": "^3.6",
        "phpoffice/phpspreadsheet": "^2.4",
        "babdev/pagerfanta-bundle": "~4.0"
    },
    "require-dev": {
        "hgabka/acl-bundle": "^7.1|^8.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0|^13.0",
        "symfony/security-acl": "^7.1|^8.0",
        "symfony/yaml": "^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Hgabka\\UtilsBundle\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hgabka\\UtilsBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0-dev",
            "dev-v8": "8.0.x-dev"
        }
    }
}
